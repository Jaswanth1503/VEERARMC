  createdAt       DateTime @default(now())

  @@index([snapshotDate])
  @@index([periodType])
}

model ExecutiveAlert {
  id          String   @id @default(uuid()) @db.Uuid
  alertType   String   // REVENUE_DROP, DEMAND_SURGE, BOTTLENECK, DELIVERY_DELAY, HEALTH_CHANGE, INVENTORY_LOW
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title       String
  message     String
  metricsJson Json?
  isRead      Boolean  @default(false)
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([alertType])
  @@index([severity])
  @@index([isRead])
}

model AnalyticsAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?
  action       String   // VIEW_DASHBOARD, GENERATE_REPORT, EXPORT_PDF, REFRESH_AI_INSIGHTS, FILTER_CHANGE
  resourceType String   @default("EXECUTIVE_ANALYTICS")
  metadataJson Json?
  ipAddress    String?

  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
