  actionItemsJson Json?    // Strategic AI leadership recommendations
  generatedBy     String?  // User or System
  downloadUrl     String?  // PDF / CSV export link
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportType])
  @@index([periodStart, periodEnd])
}

model AnalyticsSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  snapshotDate    DateTime @default(now())
  periodType      String   @default("DAILY") // HOURLY, DAILY, WEEKLY, MONTHLY
  totalRevenue    Float    @default(0)
  totalOrders     Int      @default(0)
  totalVolumeM3   Float    @default(0)
  deliveredOrders Int      @default(0)
  healthScore     Float    @default(85.0)
  onTimePercent   Float    @default(95.0)
