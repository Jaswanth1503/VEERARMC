  @@index([recipientId])
}

model ProductionPlan {
  id                   String                @id @default(uuid()) @db.Uuid
  planNumber           String                @unique // VRMC-PLAN-2026-00001
  orderId              String                @db.Uuid
  plantId              String                @db.Uuid
  plannedQuantity      Float                 // in m³
  concreteGrade        String                @default("M25")
  status               String                @default("PLANNED") // PLANNED, SCHEDULED, READY, IN_PROGRESS, COMPLETED, FAILED, CANCELLED

  scheduledDate        DateTime
  scheduledStartTime   DateTime
  scheduledEndTime     DateTime
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  
  notes                String?
  aiFeasibilityScore   Float?                @default(95.0)
  aiBottleneckWarning  String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plant                BatchingPlant         @relation(fields: [plantId], references: [id])
  batches              ProductionBatch[]
  consumptions         MaterialConsumption[]
  logs                 ProductionLog[]
  queues               ProductionQueue[]

  @@index([orderId])
  @@index([plantId])
  @@index([status])
  @@index([scheduledDate])
}

model ProductionBatch {
  id                 String                @id @default(uuid()) @db.Uuid
  productionPlanId   String                @db.Uuid
  batchNumber        String                // e.g. "B-001"
  concreteGrade      String
  quantity           Float                 // in m³ (e.g. 6.0 m³)
  mixingTimeSeconds  Int                   @default(120)
  waterCementRatio   Float                 @default(0.45)
  slumpMm            Float                 @default(120)
  temperatureCelsius Float                 @default(28.0)
  status             String                @default("PLANNED") // PLANNED, MIXING, BATCHED, LOADED, DISPATCHED, FAILED
  
  producedAt         DateTime?
  operatorName       String?               @default("Plant Operator")
  truckNumber        String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  productionPlan     ProductionPlan        @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  consumptions       MaterialConsumption[]

  @@index([productionPlanId])
  @@index([status])
}

model PlantCapacity {
  id                   String        @id @default(uuid()) @db.Uuid
  plantId              String        @db.Uuid
  date                 DateTime
  hourSlot             Int?          // 0 to 23
  maxCapacityM3        Float         @default(1500)
  reservedCapacityM3   Float         @default(0)
  utilizedCapacityM3   Float         @default(0)
  availableCapacityM3  Float         @default(1500)
  utilizationPercent   Float         @default(0)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  plant                BatchingPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, date])
}

model MaterialConsumption {
  id                String           @id @default(uuid()) @db.Uuid
  productionPlanId  String?          @db.Uuid
  productionBatchId String?          @db.Uuid
  materialName      String           // OPC Cement, Fly Ash, Sand, 20mm Agg, 10mm Agg, Water, Admixture
  category          String           // BINDER, AGGREGATE, WATER, ADMIXTURE
  plannedQtyKg      Float
  actualQtyKg       Float
  varianceKg        Float            @default(0)
  variancePercent   Float            @default(0)
  unit              String           @default("KG")
  costPerKg         Float            @default(5.0)

  consumedAt        DateTime         @default(now())

  productionPlan    ProductionPlan?  @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  @@index([productionPlanId])
  @@index([productionBatchId])
  @@index([category])
}

model ProductionForecast {
  id                    String        @id @default(uuid()) @db.Uuid
  forecastDate          DateTime      @default(now())
  forecastPeriod        String        @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  predictedDemandM3     Float         @default(0)
  highDemandWindows     String[]
  peakGrade             String        @default("M25")
  materialRequirements  Json?
  capacityBottlenecks   String[]
  aiRecommendations     String[]
  confidenceScore       Float         @default(90.0)

  generatedAt           DateTime      @default(now())

  @@index([forecastPeriod])
}

model ProductionQueue {
  id                String         @id @default(uuid()) @db.Uuid
  plantId           String         @db.Uuid
  productionPlanId  String         @db.Uuid
  priority          String         @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  queuePosition     Int            @default(1)
  estimatedStart    DateTime
  status            String         @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, BYPASSED

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  plant             BatchingPlant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  productionPlan    ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)

  @@index([plantId, status])
}

model ProductionLog {
  id                String         @id @default(uuid()) @db.Uuid
  productionPlanId  String         @db.Uuid
  action            String         // PLAN_CREATED, BATCH_STARTED, BATCH_COMPLETED, CAPACITY_EXCEEDED, SHORTAGE_ALERT
  performedBy       String         @default("System")
  details           String
  loggedAt          DateTime       @default(now())

  productionPlan    ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)

  @@index([productionPlanId])
}

model FleetVehicle {
  id                  String             @id @default(uuid()) @db.Uuid
  vehicleNumber       String             @unique // e.g. "MH-12-RN-8821"
  vehicleType         String             @default("TRANSIT_MIXER") // TRANSIT_MIXER, BOOM_PUMP, LINE_PUMP, CEMENT_BULKER
  capacity            Float              @default(6.0) // in m³
  status              String             @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_TRANSIT, LOADING, UNLOADING, MAINTENANCE, OUT_OF_SERVICE
  currentLocation     String?            @default("Central Plant (Hadapsar)")
  currentLatitude     Float?
  currentLongitude    Float?
  fuelLevelPercent    Float?             @default(85.0)
  odometerKm          Float?             @default(45200.0)
  lastMaintenanceDate DateTime?
  nextMaintenanceDue  DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  trips               DeliveryTrip[]
  drivers             Driver[]
  maintenanceRecords  FleetMaintenance[]

  @@index([status])
  @@index([vehicleType])
}

model Driver {
  id                String         @id @default(uuid()) @db.Uuid
  employeeId        String         @unique // e.g. "DRV-0104"
  name              String
  phone             String
  licenseNumber     String
  licenseExpiry     DateTime?
  status            String         @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFF_DUTY, ON_LEAVE
  assignedVehicleId String?        @db.Uuid
  experienceYears   Int            @default(5)
  rating            Float          @default(4.8)
  totalDeliveries   Int            @default(0)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedVehicle   FleetVehicle?  @relation(fields: [assignedVehicleId], references: [id])
  trips             DeliveryTrip[]

  @@index([status])
}

model DeliveryTrip {
  id                 String             @id @default(uuid()) @db.Uuid
  tripNumber         String             @unique // e.g. "TRIP-2026-00001"
  orderId            String             @db.Uuid
  productionPlanId   String?            @db.Uuid
  productionBatchId  String?            @db.Uuid
  vehicleId          String             @db.Uuid
  driverId           String             @db.Uuid
  routeId            String?            @db.Uuid
  status             String             @default("ASSIGNED") // ASSIGNED, DISPATCHED, IN_TRANSIT, ARRIVED_AT_SITE, UNLOADING, DELIVERED, CONFIRMED, CANCELLED

  concreteGrade      String             @default("M25")
  quantityM3         Float              @default(6.0)
  originPlant        String             @default("Central Batching Plant (Hadapsar)")
  destinationAddress String
  destinationCity    String             @default("Pune")
  destinationPincode String?
  distanceKm         Float              @default(14.5)

  dispatchTime       DateTime?
  estimatedArrival   DateTime
  actualArrival      DateTime?
  completedAt        DateTime?
  customerFeedback   String?
  customerRating     Int?
  aiEtaConfidence    Float?             @default(94.0)
  aiTrafficDelayMins Int?               @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle            FleetVehicle       @relation(fields: [vehicleId], references: [id])
  driver             Driver             @relation(fields: [driverId], references: [id])
  route              RoutePlan?         @relation(fields: [routeId], references: [id])
  trackings          DeliveryTracking[]
  issues             DeliveryIssue[]
  etaForecasts       ETAForecast[]

  @@index([orderId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model DeliveryTracking {
  id           String       @id @default(uuid()) @db.Uuid
  tripId       String       @db.Uuid
  latitude     Float
  longitude    Float
  speedKmh     Float        @default(35.0)
  status       String       // DISPATCHED, IN_TRANSIT, AT_SITE, UNLOADED
  locationName String?
  recordedAt   DateTime     @default(now())

  trip         DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model RoutePlan {
  id                   String         @id @default(uuid()) @db.Uuid
  originPlant          String
  destinationSite      String
  distanceKm           Float
  estimatedMinutes     Int
  recommendedRouteName String         // e.g. "Via Kharadi Bypass / Pune-Ahmednagar Hwy"
  alternativeRouteName String?
  trafficRiskScore     Float          @default(20.0) // 0-100
  roadCondition        String         @default("GOOD") // EXCELLENT, GOOD, MODERATE, CONGESTED, RESTRICTED
  aiRecommendation     String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  trips                DeliveryTrip[]
}

model DeliveryIssue {
  id              String       @id @default(uuid()) @db.Uuid
  tripId          String       @db.Uuid
  issueType       String       // TRAFFIC_DELAY, VEHICLE_BREAKDOWN, WEATHER_ISSUE, CUSTOMER_DELAY, SITE_ACCESS_PROBLEM, SLUMP_LOSS
  severity        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description     String
  delayMinutes    Int          @default(0)
  isResolved      Boolean      @default(false)
  resolutionNotes String?

  reportedAt      DateTime     @default(now())
  resolvedAt      DateTime?

  trip            DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([issueType])
}

model ETAForecast {
  id                      String       @id @default(uuid()) @db.Uuid
  tripId                  String       @db.Uuid
  calculatedAt            DateTime     @default(now())
  predictedEta            DateTime
  delayProbabilityPercent Float        @default(10.0)
  confidenceScore         Float        @default(92.0)
  trafficFactor           String       @default("MODERATE") // LOW, MODERATE, HEAVY, SEVERE
  aiExplanation           String?

  trip                    DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model FleetMaintenance {
  id              String       @id @default(uuid()) @db.Uuid
  vehicleId       String       @db.Uuid
  maintenanceType String       // ROUTINE_SERVICE, HYDRAULIC_DRUM_REPAIR, BRAKE_OVERHAUL, TYRE_REPLACEMENT, CHASSIS_INSPECTION
  scheduledDate   DateTime
  completedDate   DateTime?
  status          String       @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, OVERDUE
  cost            Float        @default(0)
  technicianName  String?
  notes           String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  vehicle         FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
}

